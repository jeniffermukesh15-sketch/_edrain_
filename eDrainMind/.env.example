# Copy this file to ".env" and fill in what you want. Everything is optional - the app runs without it.

# --- Email alerts (Gmail: turn on 2-step verification, then create an "App password") ---
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-letter-app-password
ALERT_TO=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Free AI assistant (any OpenAI-compatible free API). Default = Google Gemini free tier, key from aistudio.google.com ---
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
# If the main model is busy (HTTP 503) these are tried next. Check Google's docs for current model names.
LLM_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash
# Groq example: LLM_BASE_URL=https://api.groq.com/openai/v1  and a model name from console.groq.com

# --- Live weather location (default: Palakkad, Kerala) ---
WEATHER_PLACE=Palakkad
WEATHER_LAT=10.79
WEATHER_LON=76.65
